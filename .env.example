# Server Port
PORT=3000

# Database Configuration (PostgreSQL recommended for production, e.g. Neon)
DB_TYPE=postgres
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=verify-full

# Local SQLite Fallback (set DB_TYPE=sqlite to use local file instead of PostgreSQL)
# DB_TYPE=sqlite
# DB_PATH=./data/nexveda.db

# Contact Recipient Email
CONTACT_EMAIL=nexvedatechnologies@gmail.com

# SMTP Configuration (Gmail App Password / Generic SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nexvedatechnologies@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Security Configuration
# Comma-separated list of allowed production origins for CORS
ALLOWED_ORIGINS=https://nexvedatechnology.com,https://www.nexvedatechnology.com
# Set to true when deployed behind a reverse proxy (Hostinger / Cloudflare / Nginx)
TRUST_PROXY=true

# Resend API Key (Optional alternative to SMTP)
RESEND_API_KEY=
